server {
  listen 8080;
  resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

  location /auth/ {
    set $backend ${AUTH_HOST};
    rewrite ^/auth/(.*)$ /$1 break;
    proxy_pass https://$backend;
    proxy_http_version 1.1;
    proxy_set_header Host $backend;
    proxy_ssl_server_name on;
    proxy_ssl_name $backend;
  }

  location /profile/ {
    set $backend ${PROFILE_HOST};
    rewrite ^/profile/(.*)$ /$1 break;
    proxy_pass https://$backend;
    proxy_http_version 1.1;
    proxy_set_header Host $backend;
    proxy_ssl_server_name on;
    proxy_ssl_name $backend;
  }

  location /projects/ {
    set $backend ${PROJECTS_HOST};
    rewrite ^/projects/(.*)$ /$1 break;
    proxy_pass https://$backend;
    proxy_http_version 1.1;
    proxy_set_header Host $backend;
    proxy_ssl_server_name on;
    proxy_ssl_name $backend;
  }

  location /blog/ {
    set $backend ${BLOG_HOST};
    rewrite ^/blog/(.*)$ /$1 break;
    proxy_pass https://$backend;
    proxy_http_version 1.1;
    proxy_set_header Host $backend;
    proxy_ssl_server_name on;
    proxy_ssl_name $backend;
  }

  location /cv/ {
    set $backend ${CV_HOST};
    rewrite ^/cv/(.*)$ /$1 break;
    proxy_pass https://$backend;
    proxy_http_version 1.1;
    proxy_set_header Host $backend;
    proxy_ssl_server_name on;
    proxy_ssl_name $backend;
  }
}
